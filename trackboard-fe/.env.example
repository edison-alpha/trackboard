# Optional. With nothing set, `next dev` uses a backend on this machine and production builds use the real one.
#   production: https://api.eaco1.xyz (REST) and wss://ws.eaco1.xyz (live editing)
#   development: http://localhost:3400 and ws://localhost:3401
# Set these only to point somewhere else. A custom API with no collab URL is assumed to serve the socket at <API>/collab.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_COLLAB_URL=
