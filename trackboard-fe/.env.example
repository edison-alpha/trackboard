# Empty: documents sync between tabs of this browser and are stored in IndexedDB.
# Set to the trackdocs-be WebSocket (e.g. ws://localhost:4000/collab) to sync through Hocuspocus instead.
NEXT_PUBLIC_COLLAB_URL=

# AI (server-only, read by app/api/ai/route.ts). Anthropic-compatible endpoint; the SDK appends /v1/messages.
AI_BASE_URL=https://api.mwapi.dev
AI_API_KEY=
AI_MODEL=claude-haiku-3-5
