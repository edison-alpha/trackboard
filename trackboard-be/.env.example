# Server
PORT=3400
NODE_ENV=development
# Comma separated browser origins allowed to call the API (the Next.js app).
TB_ALLOWED_ORIGINS=http://localhost:3300
# Where the app lives; Google sign-in sends people back here.
TB_APP_ORIGIN=http://localhost:3300
# 1 when the app and the API are on different sites (Vercel -> this server): SameSite=None; Secure; Partitioned.
TB_CROSS_SITE_COOKIE=0

# Database. Empty = embedded PGlite in TB_PGLITE_DIR (local development and tests only).
DATABASE_URL=
TB_PGLITE_DIR=.tb-db

# Signs the session cookie. Required in production (openssl rand -base64 48).
SESSION_SECRET=

# Google sign-in. Redirect URI to register: <public API origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of this API, used to build the redirect URI and file URLs (production: https://api.eaco1.xyz).
# Defaults to http://localhost:PORT.
TB_PUBLIC_URL=

# Uploaded files
TB_FILES_DIR=.tb-files

# AI (Anthropic-compatible gateway; the SDK appends /v1/messages)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# Local development only: GET /api/auth/dev?name=Ana signs in without Google. Ignored in production.
TB_DEV_LOGIN=0
